# Existing Mac Worden MailerLite Classic integration. Keep these values separate
# from Jamie McFarlane groups and subscriber fields.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Exact first-party source keys and Mac series slugs accepted by the function.
# Values use comma-separated lowercase keys; nothing is accepted by default.
MAC_NEWSLETTER_ALLOWED_SOURCE_KEYS=
MAC_NEWSLETTER_ALLOWED_SERIES_KEYS=

# Exact keys returned by MailerLite after the six Mac custom text fields exist.
# Attribution enrichment remains disabled unless all six keys are configured.
MAILERLITE_MAC_SIGNUP_SOURCE_FIRST_FIELD_KEY=
MAILERLITE_MAC_SIGNUP_SERIES_FIRST_FIELD_KEY=
MAILERLITE_MAC_SIGNUP_PATH_FIRST_FIELD_KEY=
MAILERLITE_MAC_SIGNUP_SOURCE_LATEST_FIELD_KEY=
MAILERLITE_MAC_SIGNUP_SERIES_LATEST_FIELD_KEY=
MAILERLITE_MAC_SIGNUP_PATH_LATEST_FIELD_KEY=
