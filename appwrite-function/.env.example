# MailerLite Classic. The caller sends a `site` name; the function maps it to a group here.
# A group ID from the request is never used.
MAILERLITE_API_KEY=

# Mac Worden (`site: macworden`, also used when a request names no site).
MAILERLITE_GROUP_ID=

# Jamie McFarlane (`site: jamiemcfarlane`), the Privateer Tales Main group.
MAILERLITE_GROUP_ID_JAMIEMCFARLANE=

# Optional per-site keys. A site without one uses MAILERLITE_API_KEY.
# MAILERLITE_API_KEY_MACWORDEN=
# MAILERLITE_API_KEY_JAMIEMCFARLANE=

# Appwrite provides APPWRITE_FUNCTION_API_ENDPOINT, APPWRITE_FUNCTION_PROJECT_ID and a
# per-execution API key automatically. The function's scopes must include rows.read and
# rows.write so it can check attribution_routes and write newsletter_signup_events.
